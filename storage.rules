rules_version = '2';

// Deny by default. Ver .agents/rules/firebase-security.md e images-media.md.
// Las fotos las sube el servidor con el Admin SDK. El navegador solo las lee.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Lectura pública de las fotos que sube el servidor. El navegador no escribe.
    match /products/{productId}/{file} {
      allow read: if true;
      allow write: if false;
    }
  }
}
