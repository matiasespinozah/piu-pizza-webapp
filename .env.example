# Copiar a .env.local para desarrollo local (`cp .env.example .env.local`).
# Config web de Firebase del proyecto piu-pizza-cl. NO es secreta (la protegen las Security Rules).
# En producción estos valores vienen de apphosting.yaml.
# La config de arriba no enciende Firestore. pnpm dev no lee ni escribe la base real.
# PIU_FIREBASE_DATA=on solo con aprobación, y nunca en este archivo.
# PIU_RESERVATIONS_WRITES=on solo en el emulador o cuando se autorice la recepción. No activarlo aquí.
# PIU_RESERVATION_STATUS=on solo en el emulador o cuando se autorice la consulta. No enciende las escrituras. No activarlo aquí.
#
# Emuladores, solo para ensayos locales. No definirlos en App Hosting.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Ver docs/arquitectura/firebase.md y docs/arquitectura/admin-auth.md.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAtlMZnZcLyvMwX7AtUaoEswEenkBJGAy4
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=piu-pizza-cl.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=piu-pizza-cl
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=piu-pizza-cl.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=864707447905
NEXT_PUBLIC_FIREBASE_APP_ID=1:864707447905:web:a64297850b8873793d6e20
