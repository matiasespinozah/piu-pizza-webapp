rules_version = '2';

// Deny by default. El Admin SDK NO pasa por estas reglas: el servidor tiene que
// comprobar identidad y rol por su cuenta. Ver docs/arquitectura/firebase.md.
//
// Un `allow` amplio en otra regla no queda anulado por un `if false` de aquí:
// las reglas se combinan con OR. No agregar un comodín que permita leer o escribir.
service cloud.firestore {
  match /databases/{database}/documents {
    function limited() {
      return request.query.limit > 0 && request.query.limit <= 50;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // Carta pública. Solo documentos visibles, y solo lectura. El navegador no publica platos.
    match /categories/{categoryId} {
      allow get: if resource.data.isVisible == true;
      allow list: if resource.data.isVisible == true && limited();
      allow write: if false;
    }

    match /products/{productId} {
      allow get: if resource.data.isVisible == true;
      allow list: if resource.data.isVisible == true && limited();
      allow write: if false;
    }

    // Reservas, mesas, personal, ajustes y auditoría: ni siquiera un admin entra desde el cliente.
    // El teléfono y el nombre del cliente viven en reservations y no se pueden leer desde el navegador.
    match /reservations/{reservationId} {
      allow read, write: if false;

      match /events/{eventId} {
        allow read, write: if false;
      }
    }

    match /reservationHolds/{holdId} {
      allow read, write: if false;
    }

    match /reservationRate/{rateId} {
      allow read, write: if false;
    }

    match /reservationAccess/{accessId} {
      allow read, write: if false;
    }

    match /reservationStatusRate/{rateId} {
      allow read, write: if false;
    }

    match /tables/{tableId} {
      allow read, write: if false;
    }

    match /staff/{uid} {
      allow read, write: if false;
    }

    match /invitations/{inviteId} {
      allow read, write: if false;
    }

    match /invitationRate/{rateId} {
      allow read, write: if false;
    }

    match /restaurantSettings/{docId} {
      allow read, write: if false;
    }

    match /auditLogs/{logId} {
      allow read, write: if false;
    }

    match /reservationDays/{dayId} {
      allow read, write: if false;
    }
  }
}
